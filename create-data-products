#!/usr/bin/env duckdb -f

.timer on

-- typed fields

copy (
    select
        source_id,
        site_id,
        epoch_ms(readout_time) at time zone 'utc' as readout_time,
        (voltage->>'float')::double as voltage,
        (pt100_resistance->>'float')::double as pt100_resistance,
        (cvf3_fan_speed->>'float')::double as cvf3_fan_speed,
        (heater_1->>'int')::int as heater_1,
        (heater_2->>'int')::int as heater_2,
    from 'export/reading.sensor.cmp22.jsonl.gz'
    order by readout_time
) to 'neon/reading.sensor.cmp22.parquet' (format parquet, parquet_version v2, compression zstd);

