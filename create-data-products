copy (
    select
        source_id,
        site_id,
        epoch_ms(readout_time) at time zone 'utc' as readout_time,
        -- packet counter arrives as 2 raw bytes rendered as Latin-1 chars
        -- ("\u00BF\u00B1" = 0xBFB1 = 49073); decode to a 16-bit int (wraps at 65535)
        unicode(substring(packet_counter->>'mti300ahrs_packet_counter', 1, 1)) * 256
          + unicode(substring(packet_counter->>'mti300ahrs_packet_counter', 2, 1)) as packet_counter,
        (roll->>'float')::double as roll,
        (pitch->>'float')::double as pitch,
        (yaw->>'float')::double as yaw,
        (acceleration_x->>'float')::double as acceleration_x,
        (acceleration_y->>'float')::double as acceleration_y,
        (acceleration_z->>'float')::double as acceleration_z,
        (free_acceleration_x->>'float')::double as free_acceleration_x,
        (free_acceleration_y->>'float')::double as free_acceleration_y,
        (free_acceleration_z->>'float')::double as free_acceleration_z,
        (gyroscope_x->>'float')::double as gyroscope_x,
        (gyroscope_y->>'float')::double as gyroscope_y,
        (gyroscope_z->>'float')::double as gyroscope_z,
        (status_word->>'int')::int as status_word,
    from 'export/reading.sensor.mti300ahrs.jsonl.gz'
    order by readout_time
) to 'neon/reading.sensor.mti300ahrs.parquet' (format parquet, parquet_version v2, compression zstd);

