        (precipiation_accumulation_rate->>'float')::double as precipitation_accumulation_rate,
        (strain_gauge1_stability->>'int')::int as strain_gauge1_stability,
        (strain_gauge2_stability->>'int')::int as strain_gauge2_stability,
