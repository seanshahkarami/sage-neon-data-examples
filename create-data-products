        (strain_gauge2_frequency_raw->>'float')::double as strain_gauge2_frequency_raw,
        (strain_gauge3_frequency_raw->>'float')::double as strain_gauge3_frequency_raw,
        (strain_gauge1_frequency_compensated->>'float')::double as strain_gauge1_frequency_compensated,
        (strain_gauge2_frequency_compensated->>'float')::double as strain_gauge2_frequency_compensated,
