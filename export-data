#!/bin/bash

set -euo pipefail

sensors=(
    cmp22
    hmp155
    ptb330a
    csat3b
    li850
    nr01
    hfp01sc
    dualfan
    grape
    mwseries
    mcseries
    si111
    spn1
    gmp343
    windobserverii
    aepg600m_heated
    mti300ahrs
    solenoid
    # these are bare scalar fields (no {"type": "value"} wrapping)
    prt
    pqs1
    pump
    pressuretransducer
    li191r
    picarro3way
)

mkdir -p export

for sensor in "${sensors[@]}"; do
    outfile="export/reading.sensor.${sensor}.jsonl.gz"
    echo "exporting reading.sensor.${sensor}" >&2
    if time ./read-topic "reading.sensor.${sensor}" | gzip > "${outfile}.tmp"; then
        mv "${outfile}.tmp" "${outfile}"
        echo "done" "reading.sensor.${sensor}" >&2
    else
        echo "fail" "reading.sensor.${sensor}" >&2
    fi
done
